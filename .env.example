# Yahoo Finance is the default no-key historical provider for personal/research use.

# Twelve Data can be used as an API-key fallback.
TWELVE_DATA_API_KEY=

# Stooq CSV historical downloads require API key access.
STOOQ_API_KEY=

# Future optional providers. Adapters are not implemented yet.
FMP_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=

# Refinitiv / LSEG requires licensed enterprise access.
# Keep credentials server-side only; future adapters should run server-side or through a local proxy.
LSEG_APP_KEY=
LSEG_CLIENT_ID=
LSEG_CLIENT_SECRET=
REFINITIV_LOCAL_PROXY_URL=
